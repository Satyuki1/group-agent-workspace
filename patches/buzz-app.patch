@@ -0,0 +1,30 @@
+/** Only workspace-relative resources are passed across the embed boundary. */
+export type ResourceRequest = { id: string; channelId: string; path: string };
+export function workspacePath(value: string) {
+  if (!value.startsWith("/work/")) return;
+  const path = value.slice(6);
+  if (
+    !path ||
+    /[\\%\x00-\x1f]/.test(path) ||
+    path.split("/").some((part) => !part || part === "." || part === "..")
+  )
+    return;
+  return path;
+}
+export function artifactPaths(content: string) {
+  return [
+    ...new Set(
+      content.match(
+        /\/work\/[^\s`<>()[\]，。；：！？]+\.(?:md|txt|csv|json|html|pdf|png|jpg|svg|xlsx|docx|pptx)\b/gi,
+      ) ?? [],
+    ),
+  ]
+    .filter((path) => workspacePath(path))
+    .slice(0, 8);
+}
+export function fileAddress(sessionId: string, path: string) {
+  const relative = workspacePath(path);
+  if (!relative) return;
+  return `dsh-resource://file/session/${encodeURIComponent(sessionId)}/${relative.split("/").map(encodeURIComponent).join("/")}`;
+}
+export const resourceEvent = "team-resource-open";
