+import { describe, it, expect } from "vitest";
+import { dayLabel, recentConversations } from "./presentation";
+import { artifactPaths, fileAddress, workspacePath } from "./artifacts";
+
+describe("recent chat presentation", () => {
+  it("keeps starred chats first, deduplicates destinations and searches previews", () => {
+    const early = {
+      id: "a",
+      name: "调研群",
+      preview: "周报",
+      lastActivityAt: 10,
+    };
+    const late = { id: "b", name: "同事", preview: "方案", lastActivityAt: 30 };
+    const sections = [
+      { key: "starred", rows: [early] },
+      { key: "channels", rows: [late, early] },
+    ];
+    expect(
+      recentConversations(sections, "").map((row) => row.channel.id),
+    ).toEqual(["a", "b"]);
+    expect(
+      recentConversations(sections, "  方案 ").map((row) => row.channel.id),
+    ).toEqual(["b"]);
+    expect(
+      recentConversations([{ key: "dms", rows: [early, late] }], "").map(
+        (row) => row.channel.id,
+      ),
+    ).toEqual(["b", "a"]);
+    expect(recentConversations(sections, "不存在")).toEqual([]);
+  });
+  it("uses local calendar dates across the new-year midnight boundary", () => {
+    const now = new Date(2026, 0, 1, 0, 1);
+    expect(dayLabel(new Date(2025, 11, 31, 23, 59).getTime() / 1000, now)).toBe(
+      "昨天",
+    );
+    expect(dayLabel(now.getTime() / 1000, now)).toBe("今天");
+    expect(dayLabel(new Date(2024, 11, 31).getTime() / 1000, now)).toContain(
+      "2024",
+    );
+  });
+});
+
+describe("native workspace resource routing", () => {
+  it("extracts unique supported workspace files from real response prose", () => {
+    expect(
+      artifactPaths(
+        "完成：`/work/report.md`，预览 [/work/report.md](/work/report.md)，图片 /work/chart.png。",
+      ),
+    ).toEqual(["/work/report.md", "/work/chart.png"]);
+  });
+  it("does not forward traversal, encoded traversal or paths outside the workspace", () => {
+    for (const path of [
+      "/etc/passwd",
+      "/work/../private.md",
+      "/work/a/../private.md",
+      "/work/%2e%2e/private.md",
+      "/work/a\\..\\private.md",
+      "/work//other.md",
+    ]) {
+      expect(workspacePath(path)).toBeUndefined();
+      expect(fileAddress("session", path)).toBeUndefined();
+    }
+    expect(artifactPaths("/work/../private.md /etc/other.md")).toEqual([]);
+  });
+  it("encodes a native session resource without treating filename punctuation as a URL", () => {
+    expect(fileAddress("session-1", "/work/方案 #1.md")).toBe(
+      "dsh-resource://file/session/session-1/%E6%96%B9%E6%A1%88%20%231.md",
+    );
+  });
+});
