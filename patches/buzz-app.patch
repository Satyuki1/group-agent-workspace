@@ -0,0 +1,21 @@
+import { communityDestination } from "../features/communities/destination";
+import { parseOpenTarget } from "../features/navigation/targets";
+
+/** Repair only the community-less IM entry produced by the old Web shell. */
+export function repairTeamEntry(hash: string, saved: string | null, publicKey: string, relayOrigin: string) {
+  if (!/^[a-f0-9]{64}$/.test(publicKey)) return;
+  try {
+    const team = communityDestination(relayOrigin);
+    let target;
+    if (hash.startsWith("#buzz=")) {
+      const addressed = parseOpenTarget(JSON.parse(decodeURIComponent(hash.slice(6))));
+      if (addressed.kind !== "page" || addressed.pluginId !== "buzz.channels" || addressed.pageId !== "channels" || addressed.scope !== null) return;
+      target = addressed;
+    } else if (!hash && saved) {
+      const record = JSON.parse(saved);
+      if (record?.selected !== null || !Array.isArray(record.memberships) || !record.memberships.some((m: {id?: string}) => m?.id === team.id)) return;
+      target = {version: 1, kind: "page", pluginId: "buzz.channels", pageId: "channels"};
+    } else return;
+    return "#buzz=" + encodeURIComponent(JSON.stringify({...target, scope: {viewer: publicKey, communityOrigin: team.url}}));
+  } catch { /* Other or unreadable destinations retain native recovery behavior. */ }
+}
