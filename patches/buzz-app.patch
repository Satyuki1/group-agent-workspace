diff --git a/src/team/HarnessWorkspace.tsx b/src/team/HarnessWorkspace.tsx
new file mode 100644
index 0000000..9281258
--- /dev/null
+++ b/src/team/HarnessWorkspace.tsx
@@ -0,0 +1,241 @@
+import { fileAddress, type ResourceRequest } from "./artifacts";
+import { useCallback, useEffect, useRef, useState, type ReactNode } from "react";
+import { Button } from "../shared/design-system/ui/Button";
+import { appCall } from "./im-api";
+import styles from "./HarnessWorkspace.module.css";
+import { useTaskFeed } from "./task-feed";
+import { liveWorkspaceEvent } from "./WorkingAgents";
+
+type Binding = {
+  state: "ready";
+  spaceId: string;
+  sessionId: string;
+  url: string;
+};
+type WorkspaceState = {
+  channelId: string;
+  binding?: Binding;
+  error?: string;
+  preparing?: boolean;
+  warning?: string;
+  canRetry?: boolean;
+};
+
+/** Selection is transient; the server independently verifies every resource read. */
+export function useHarnessWorkspace(channelId: string | undefined) {
+  const [state, setState] = useState<WorkspaceState>();
+  const [revision, setRevision] = useState(0);
+  const [retrying, setRetrying] = useState(false);
+  const request = useRef<AbortController | null>(null);
+  useEffect(() => {
+    if (!channelId || import.meta.env.VITE_TEAM_WEB !== "1") return;
+    const controller = new AbortController();
+    request.current = controller;
+    setRetrying(false);
+    let timer: ReturnType<typeof setTimeout>;
+    const refresh = () =>
+      void fetch(
+        `/api/app/conversations/${encodeURIComponent(channelId)}/workspace`,
+        { signal: controller.signal },
+      )
+        .then(async (response) => {
+          const value = await response.json();
+          if (controller.signal.aborted) return;
+          if ([401, 403, 404].includes(response.status)) {
+            setState({
+              channelId,
+              error: value.error ?? "无法访问这个工作空间",
+            });
+            return;
+          }
+          if (!response.ok)
+            throw new Error(value.error ?? "工作空间暂时无法连接");
+          if (value.state === "ready") {
+            setState({
+              channelId,
+              binding: value,
+              warning: value.warning,
+              canRetry: value.canRetry,
+            });
+            if (value.pendingBindings && !value.failedBindings)
+              timer = setTimeout(refresh, 2000);
+          } else if (value.state === "preparing") {
+            setState({ channelId, preparing: true });
+            timer = setTimeout(refresh, 2000);
+          } else if (value.state === "failed") {
+            setState({
+              channelId,
+              error: value.message,
+              canRetry: value.canRetry,
+            });
+          } else setState({ channelId });
+        })
+        .catch((error) => {
+          if (!controller.signal.aborted) {
+            setState((previous) =>
+              previous?.channelId === channelId && previous.binding
+                ? {
+                    channelId,
+                    binding: previous.binding,
+                    warning: "工作空间连接暂时中断，正在重连…",
+                  }
+                : { channelId, error: error.message },
+            );
+            timer = setTimeout(refresh, 2000);
+          }
+        });
+    refresh();
+    return () => {
+      controller.abort();
+      clearTimeout(timer);
+    };
+  }, [channelId, revision]);
+  async function retry() {
+    const controller = request.current;
+    if (!channelId || !controller || retrying) return;
+    setRetrying(true);
+    try {
+      await appCall(
+        `conversations/${encodeURIComponent(channelId)}/workspace/retry`,
+        {},
+        controller.signal,
+      );
+      if (!controller.signal.aborted) setRevision((value) => value + 1);
+    } catch (error) {
+      if (!controller.signal.aborted) {
+        setState((previous) => ({
+          ...previous,
+          channelId,
+          error: error instanceof Error ? error.message : "重试未完成",
+        }));
+        setRetrying(false);
+      }
+    }
+  }
+  return state?.channelId === channelId
+    ? { ...state, retry, retrying }
+    : undefined;
+}
+
+export function WorkspaceNotice({
+  message,
+  retry,
+  retrying,
+}: {
+  message: string;
+  retry?: (() => void) | undefined;
+  retrying?: boolean | undefined;
+}) {
+  return (
+    <div className={styles.notice} role="status">
+      <span>{message}</span>
+      {retry && (
+        <Button size="sm" onClick={retry} disabled={retrying}>
+          {retrying ? "正在重试…" : "重试"}
+        </Button>
+      )}
+    </div>
+  );
+}
+
+export function HarnessWorkspace({
+  binding,
+  channelId,
+  shared,
+  resource,
+  notice,
+}: {
+  binding: Binding;
+  channelId: string;
+  shared: boolean;
+  resource?: ResourceRequest | undefined;
+  notice?: ReactNode;
+}) {
+  const frame = useRef<HTMLIFrameElement>(null);
+  const [error, setError] = useState("");
+  const activity = useTaskFeed(channelId);
+  const latest = useRef(activity);
+  latest.current = activity;
+  const sendActivity = useCallback(() => frame.current?.contentWindow?.postMessage({
+    type: "workspace.activity", requestId: "activity", spaceId: binding.spaceId,
+    conversationId: channelId, ready: latest.current.tasks !== undefined, after: latest.current.resourcesAfter, tasks: latest.current.tasks ?? [], error: latest.current.error,
+  }, location.origin), [binding.spaceId, channelId]);
+  useEffect(() => { sendActivity(); }, [activity.tasks, activity.error, sendActivity]);
+  useEffect(() => {
+    const requestId = crypto.randomUUID();
+    const address = resource && fileAddress(binding.sessionId, resource.path);
+    const bind = () =>
+      frame.current?.contentWindow?.postMessage(
+        {
+          type: "workspace.bind",
+          requestId,
+          spaceId: binding.spaceId,
+          sessionId: binding.sessionId,
+          conversationId: channelId,
+          shared,
+        },
+        location.origin,
+      );
+    const listener = (event: MessageEvent) => {
+      if (
+        event.source !== frame.current?.contentWindow ||
+        event.origin !== location.origin
+      )
+        return;
+      const value = event.data;
+      if (!value || value.spaceId !== binding.spaceId) return;
+      if (value.type === "workspace.ready" && value.requestId === "boot")
+        bind();
+      if (value.requestId !== requestId && value.requestId !== resource?.id)
+        return;
+      if (value.type === "workspace.error")
+        setError("无法打开工作空间，请刷新重试");
+      if (value.type === "workspace.ready") {
+        setError("");
+        if (value.requestId === requestId) sendActivity();
+        if (value.requestId === requestId && address && resource)
+          frame.current?.contentWindow?.postMessage(
+            {
+              type: "resource.open",
+              requestId: resource.id,
+              spaceId: binding.spaceId,
+              address,
+            },
+            location.origin,
+          );
+      }
+    };
+    window.addEventListener("message", listener);
+    const openLive = (event: Event) => {
+      if ((event as CustomEvent<string>).detail === channelId)
+        frame.current?.contentWindow?.postMessage({ type: "workspace.live", requestId: "live", spaceId: binding.spaceId }, location.origin);
+    };
+    window.addEventListener(liveWorkspaceEvent, openLive);
+    const target = frame.current;
+    target?.addEventListener("load", bind);
+    bind();
+    return () => {
+      window.removeEventListener("message", listener);
+      window.removeEventListener(liveWorkspaceEvent, openLive);
+      target?.removeEventListener("load", bind);
+    };
+  }, [binding.spaceId, binding.sessionId, channelId, shared, resource, sendActivity]);
+  return (
+    <div className={styles.workspace}>
+      {notice}
+      {error && (
+        <p className={styles.error} role="alert">
+          {error}
+        </p>
+      )}
+      <iframe
+        ref={frame}
+        src={binding.url}
+        title="Harness 工作面"
+        className={styles.frame}
+        allow="clipboard-read; clipboard-write; fullscreen"
+        sandbox="allow-scripts allow-same-origin allow-downloads allow-forms allow-popups"
+      />
+    </div>
+  );
+}
