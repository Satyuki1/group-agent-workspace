+import { useEffect, useSyncExternalStore } from "react";
+import type { RelaySession } from "../features/relay/session";
+import { Avatar } from "../shared/design-system/ui/Avatar";
+import { UsersIcon } from "../shared/design-system/icons";
+import { avatarMedia } from "../shared/avatar-source";
+import { AgentFace } from "./AgentFace";
+import styles from "./TeamChatAvatar.module.css";
+
+/** Group identity is composed from the actual roster, including its Agents. */
+export function TeamChatAvatar({ session, channelId, members }: {
+  session: RelaySession; channelId: string; members: readonly string[];
+}) {
+  const profiles = useSyncExternalStore(session.profiles.subscribe, session.profiles.snapshot, session.profiles.snapshot);
+  const ids = members.slice(0, 9), key = ids.join(":");
+  useEffect(() => {
+    if (key) void session.profiles.ensure(key.split(":"), "background").catch(() => {});
+  }, [session, key]);
+  if (!ids.length) return <UsersIcon aria-label="群聊" />;
+  return <span className={styles.grid} data-count={ids.length} aria-label={`${members.length} 位群成员`} data-group-avatar={channelId}>
+    {ids.map(id => {
+      const profile = profiles.get(id);
+      return <span className={styles.member} key={id}>{profile?.isAgent
+        ? <AgentFace avatar={profile.picture} />
+        : <Avatar size="fill" alt="" fallback={profile?.name ?? "成员"} src={avatarMedia(profile?.picture, session.media)} />}</span>;
+    })}
+  </span>;
+}
