+// @vitest-environment jsdom
+import "@testing-library/jest-dom/vitest";
+import { act, cleanup, render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { StrictMode } from "react";
+import { afterEach, expect, it, vi } from "vitest";
+import type { ComposerAccessoryProps } from "../features/conversation/contracts";
+import { useTaskExtensions } from "./LiveTaskResponse";
+vi.mock("./presentation", () => ({ teamWeb: true }));
+class Source {
+  static all: Source[] = [];
+  onmessage?: (event: { data: string }) => void;
+  onerror?: () => void;
+  revoked?: () => void;
+  closed = false;
+  constructor() {
+    Source.all.push(this);
+  }
+  addEventListener(_type: string, fn: () => void) {
+    this.revoked = fn;
+  }
+  close() {
+    this.closed = true;
+  }
+  send(task: unknown) {
+    this.onmessage?.({ data: JSON.stringify({ reset: true, tasks: [task] }) });
+  }
+  remove(id: string) {
+    this.onmessage?.({data: JSON.stringify({reset: false, tasks: [], removed: [id]})});
+  }
+}
+afterEach(() => {
+  cleanup();
+  Source.all = [];
+  vi.unstubAllGlobals();
+});
+function Harness({ represented = false }: { represented?: boolean }) {
+  const extensions = useTaskExtensions(undefined);
+  const Component = extensions!.accessories!.snapshot()[0]!.component;
+  return (
+    <Component
+      {...({
+        channelId: "group",
+        message: { id: "source" },
+        session: {
+          channels: {
+            ensure: () => {},
+            subscribeWindow: () => () => {},
+            window: () => (represented ? finalWindow : emptyWindow),
+          },
+        },
+      } as unknown as ComposerAccessoryProps)}
+    />
+  );
+}
+const emptyWindow = { rows: [] },
+  finalWindow = { rows: [{ id: "formal-final" }] };
+it("removes a running response when it leaves the server window", () => {
+  vi.stubGlobal("EventSource", Source);
+  render(<Harness />);
+  const source=Source.all.at(-1)!;
+  act(()=>source.send({id:"old",source_event_id:"source",agent:"助手",public_key:"agent",status:"running",created_at:new Date(0).toISOString(),progress:{phase:"thinking"}}));
+  expect(screen.getByText("正在分析请求")).toBeVisible();
+  act(()=>source.remove("old"));expect(screen.queryByText("正在分析请求")).not.toBeInTheDocument();
+});
+it("uses one shared live feed in StrictMode, streams real updates and hands text to the formal reply", async () => {
+  vi.stubGlobal("EventSource", Source);
+  const h = render(
+    <StrictMode>
+      <Harness />
+    </StrictMode>,
+  );
+  const source = Source.all.at(-1)!;
+  expect(Source.all.filter((item) => !item.closed)).toHaveLength(1);
+  const task = {
+    id: "task",
+    source_event_id: "source",
+    public_key: "agent",
+    agent: "助手",
+    created_at: new Date().toISOString(),
+    status: "running",
+    progress: { phase: "thinking", text: "", tools: [] },
+  };
+  act(() => source.send(task));
+  expect(screen.getByText("正在分析请求")).toBeVisible();
+  act(() =>
+    source.send({
+      ...task,
+      progress: { phase: "answering", text: "第一段", tools: [] },
+    }),
+  );
+  expect(screen.getByText("第一段")).toBeVisible();
+  const tool = {
+    id: "tool",
+    name: "read",
+    state: "completed",
+    input: '{"path":"/work/a.md"}',
+    output: "读取成功",
+  };
+  act(() =>
+    source.send({
+      ...task,
+      progress: { phase: "answering", text: "第一段继续", tools: [tool] },
+    }),
+  );
+  expect(screen.queryByText("第一段", { exact: true })).toBeNull();
+  expect(screen.getByText("第一段继续")).toBeVisible();
+  await userEvent
+    .setup()
+    .click(screen.getByRole("button", { name: /执行过程/ }));
+  expect(screen.getByText("读取成功")).toBeVisible();
+  act(() =>
+    source.send({
+      ...task,
+      status: "completed",
+      final_event_id: "formal-final",
+      progress: { phase: "done", text: "第一段继续", tools: [tool] },
+    }),
+  );
+  h.rerender(
+    <StrictMode>
+      <Harness represented />
+    </StrictMode>,
+  );
+  expect(screen.queryByText("第一段继续")).toBeNull();
+  expect(screen.getByText("读取成功")).toBeVisible();
+  act(() => source.onerror?.());
+  expect(screen.queryByText(/进度连接中断/)).toBeNull();
+  act(() => source.revoked?.());
+  expect(screen.queryByText("读取成功")).toBeNull();
+  expect(source.closed).toBe(true);
+});
+it("keeps the observed prefix offline and ignores a retired connection after reconnect", () => {
+  vi.stubGlobal("EventSource", Source);
+  render(<Harness />);
+  const old = Source.all.at(-1)!;
+  const task = {
+    id: "network-task",
+    source_event_id: "source",
+    public_key: "agent",
+    agent: "助手",
+    created_at: new Date().toISOString(),
+    status: "running",
+    progress: { phase: "answering", text: "已收到的片段" },
+  };
+  act(() => old.send(task));
+  act(() => window.dispatchEvent(new Event("offline")));
+  expect(old.closed).toBe(true);
+  expect(screen.getByText("已收到的片段")).toBeVisible();
+  expect(screen.getByText(/进度连接中断/)).toBeVisible();
+  act(() => window.dispatchEvent(new Event("online")));
+  const current = Source.all.at(-1)!;
+  expect(current).not.toBe(old);
+  act(() => old.send({ ...task, progress: { text: "旧连接的内容" } }));
+  expect(screen.queryByText("旧连接的内容")).toBeNull();
+  act(() =>
+    current.send({
+      ...task,
+      progress: { phase: "answering", text: "恢复后的真实片段" },
+    }),
+  );
+  expect(screen.getByText("恢复后的真实片段")).toBeVisible();
+  expect(screen.queryByText(/进度连接中断/)).toBeNull();
+});
diff --git a/src/team/LiveTaskResponse.tsx b/src/team/LiveTaskResponse.tsx
