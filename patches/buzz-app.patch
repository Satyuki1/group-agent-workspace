+import { useEffect, useRef, useState } from "react";
+import type { Navigation } from "../features/navigation/controller";
+import type { RelayData } from "../features/relay/service";
+import { useRelayConnection } from "../features/relay/react";
+import { SearchField } from "../shared/design-system/ui/SearchField";
+import { NavigationItem } from "../shared/design-system/ui/NavigationItem";
+import { Button } from "../shared/design-system/ui/Button";
+import { Avatar } from "../shared/design-system/ui/Avatar";
+import { AgentFace } from "./AgentFace";
+import { appCall, openContact, type Contact } from "./im-api";
+import styles from "./TeamIM.module.css";
+
+export function TeamContacts({
+  relay,
+  navigator,
+  active,
+  onOpenChat,
+}: {
+  relay: RelayData;
+  navigator: Navigation;
+  active: boolean;
+  onOpenChat(): void;
+}) {
+  const connection = useRelayConnection(relay);
+  const [search, setSearch] = useState("");
+  const [contacts, setContacts] = useState<Contact[]>(),
+    [error, setError] = useState(""),
+    [pending, setPending] = useState("");
+  const [revision, setRevision] = useState(0);
+  const request = useRef<AbortController | null>(null);
+  useEffect(() => {
+    if (!active) return;
+    const controller = new AbortController();
+    request.current = controller;
+    setContacts(undefined);
+    setError("");
+    setPending("");
+    void appCall<{ people: Contact[]; agents: Contact[] }>(
+      "directory",
+      undefined,
+      controller.signal,
+    )
+      .then((data) => {
+        if (!controller.signal.aborted)
+          setContacts([...data.people, ...data.agents]);
+      })
+      .catch((e) => {
+        if (!controller.signal.aborted) setError(e.message);
+      });
+    return () => controller.abort();
+  }, [active, revision, connection.session]);
+  const entries = contacts?.filter((c) =>
+    c.name.toLocaleLowerCase().includes(search.trim().toLocaleLowerCase()),
+  );
+  async function message(contact: Contact) {
+    if (pending || !connection.session) return;
+    const controller = request.current;
+    if (!controller) return;
+    setPending(contact.id);
+    setError("");
+    try {
+      await openContact(
+        contact,
+        connection.session,
+        relay,
+        navigator,
+        controller.signal,
+      );
+      if (!controller.signal.aborted) onOpenChat();
+    } catch (e) {
+      if (!controller.signal.aborted)
+        setError(e instanceof Error ? e.message : "无法打开对话");
+    } finally {
+      if (!controller.signal.aborted) setPending("");
+    }
+  }
+  return (
+    <section aria-label="通讯录" className={styles.directory}>
+      <div className={styles.form}>
+        <SearchField
+          label="搜索通讯录"
+          placeholder="搜索同事或智能体"
+          value={search}
+          onValueChange={setSearch}
+        />
+        {error && (
+          <p className={styles.notice} role="alert">
+            {error}{" "}
+            <Button size="sm" onClick={() => setRevision((v) => v + 1)}>
+              重试
+            </Button>
+          </p>
+        )}
+        {!contacts && !error && (
+          <p className={styles.notice} role="status">
+            正在读取通讯录…
+          </p>
+        )}
+        {contacts && entries?.length === 0 && (
+          <p className={styles.notice}>没有找到联系人</p>
+        )}
+        <div className={styles.contacts}>
+          {entries?.map((contact) => (
+            <NavigationItem
+              key={contact.id}
+              variant="conversation"
+              multiline
+              disabled={!!pending || !contact.ready}
+              aria-label={`与${contact.name}聊天`}
+              onClick={() => void message(contact)}
+              icon={
+                <span className={styles.avatar}>
+                  {contact.kind === "agent" ? (
+                    <AgentFace avatar={contact.avatar} />
+                  ) : (
+                    <Avatar
+                      alt=""
+                      fallback={
+                        contact.name.split("·").at(-1)?.trim() ?? contact.name
+                      }
+                      size="fill"
+                      shape="circle"
+                    />
+                  )}
+                </span>
+              }
+              label={
+                <span className={styles.contactText}>
+                  <span>{contact.name}</span>
+                  <span className={styles.meta}>
+                    {pending === contact.id
+                      ? "正在打开…"
+                      : !contact.ready
+                        ? "正在创建…"
+                        : contact.kind === "agent"
+                          ? "智能体"
+                          : "同事"}
+                  </span>
+                </span>
+              }
+            />
+          ))}
+        </div>
+      </div>
+    </section>
+  );
+}
