+import { useState, useSyncExternalStore } from "react";
+import { DownloadIcon } from "../shared/design-system/icons";
+import { IconButton } from "../shared/design-system/ui/IconButton";
+import { Dialog } from "../shared/design-system/ui/Dialog";
+import { installStatus, promptInstall, subscribeInstall } from "./install";
+
+export function InstallApp() {
+  const status = useSyncExternalStore(subscribeInstall, installStatus);
+  const [help, setHelp] = useState(false);
+  const [failed, setFailed] = useState(false);
+  if (status === "installed") return null;
+  return <>
+    <IconButton
+      aria-label="安装应用" title="安装应用" size="lg" shape="round"
+      variant="ghost" icon={<DownloadIcon size={21} />}
+      onClick={() => {
+        setFailed(false);
+        void promptInstall().then(shown => { if (!shown) setHelp(true); })
+          .catch(() => { setFailed(true); setHelp(true); });
+      }}
+    />
+    <Dialog open={help} onOpenChange={setHelp} title="安装群体智能"
+      closeLabel="关闭" size="compact"
+      description={failed ? "安装弹窗未能打开，请使用浏览器安装入口。" : "安装后以独立窗口打开，也可以固定到程序坞或任务栏。"}>
+      <ol>
+        <li>在 Chrome 普通窗口中打开当前页面。</li>
+        <li>点击地址栏右侧的安装图标；也可在浏览器菜单中选择“将网页安装为应用”。</li>
+        <li>确认名称“群体智能”，点击“安装”。</li>
+      </ol>
+      <p>如未出现安装入口，请刷新页面，并确认内网 HTTPS 证书已受信任。隐身窗口不支持安装。</p>
+    </Dialog>
+  </>;
+}
