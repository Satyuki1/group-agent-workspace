index 0000000..7121ad2
--- /dev/null
+++ b/src/team/LiveTaskResponse.tsx
@@ -0,0 +1,245 @@
+import { useMemo, useState } from "react";
+import type {
+  ConversationExtensions,
+  ComposerAccessory,
+  ComposerAccessoryProps,
+} from "../features/conversation/contracts";
+import type { Contribution } from "../plugins/contributions";
+import { Button } from "../shared/design-system/ui/Button";
+import { useChannelWindow } from "../features/relay/react";
+import { AgentFace } from "./AgentFace";
+import { appCall } from "./im-api";
+import { teamWeb } from "./presentation";
+import { useTaskFeed, type LiveTask } from "./task-feed";
+import styles from "./LiveTaskResponse.module.css";
+
+const statuses: Record<string, string> = {
+  queued: "排队中",
+  running: "执行中",
+  completed: "已完成",
+  failed: "执行失败",
+  cancelled: "已停止",
+  needs_review: "需要核对",
+  waiting_input: "等待补充",
+  waiting_approval: "等待确认",
+};
+const phases: Record<string, string> = {
+  preparing: "准备执行",
+  thinking: "正在分析请求",
+  answering: "正在回复",
+  "tool-input": "正在准备工具调用",
+  "tool-running": "正在使用工具",
+  reconnecting: "执行进度连接中断，正在恢复",
+};
+const toolNames: Record<string, string> = {open_browser:"打开网页",bash:"执行命令",read:"读取文件",write:"写入文件",edit:"编辑文件",shell:"执行命令",web_search:"检索资料",web_fetch:"读取网页"};
+function TaskResponse({
+  task,
+  represented,
+}: {
+  task: LiveTask;
+  represented: boolean;
+}) {
+  const [expanded, setExpanded] = useState(false),
+    [pending, setPending] = useState(false),
+    [error, setError] = useState("");
+  const active = [
+    "queued",
+    "running",
+    "waiting_input",
+    "waiting_approval",
+  ].includes(task.status);
+  const progress = task.progress ?? {},
+    tools = progress.tools ?? [],
+    last = tools.at(-1);
+  const label =
+    task.cancel_requested && active
+      ? "正在停止"
+      : task.status === "running"
+        ? (phases[progress.phase ?? ""] ?? "执行中")
+        : (statuses[task.status] ?? task.status);
+  async function cancel() {
+    setPending(true);
+    setError("");
+    try {
+      await appCall(`tasks/${task.id}/actions`, { action: "cancel" });
+    } catch (e) {
+      setError(e instanceof Error ? e.message : "未能停止任务");
+    } finally {
+      setPending(false);
+    }
+  }
+  const showText =
+    !!progress.text && !(represented && task.status === "completed");
+  const notes =
+    progress.messages?.filter((m) => m.text !== progress.text) ?? [];
+  if (!active && !showText && !tools.length && !notes.length) return null;
+  return (
+    <section
+      className={styles.response}
+      data-live-task={task.id}
+      data-task-status={task.status}
+      data-final-event-id={task.final_event_id ?? undefined}
+      aria-label={`${task.agent}的执行过程`}
+    >
+      <div className={styles.face}>
+        <AgentFace avatar={task.avatar} working={task.status === "running"} />
+      </div>
+      <div className={styles.body}>
+        <div className={styles.heading}>
+          <span>{task.agent}</span>
+          <span className={styles.status} role="status">
+            {label}
+          </span>
+          {active && (
+            <Button
+              variant="ghost"
+              size="caption"
+              disabled={pending || task.cancel_requested}
+              onClick={() => void cancel()}
+            >
+              停止
+            </Button>
+          )}
+        </div>
+        {showText && (
+          <div className={styles.text} data-streaming-text="">
+            {progress.text}
+          </div>
+        )}
+        {active && last && (
+          <div className={styles.status}>
+            {last.state === "running" ? "调用中" : "已调用"} · {toolNames[last.name] ?? "工具"}
+          </div>
+        )}
+        {!!(tools.length || notes.length) && (
+          <Button
+            variant="ghost"
+            size="caption"
+            aria-expanded={expanded}
+            onClick={() => setExpanded((value) => !value)}
+          >
+            {expanded
+              ? "收起执行过程"
+              : `执行过程${tools.length ? ` · ${tools.length} 次工具调用` : ""}`}
+          </Button>
+        )}
+        {expanded && (
+          <div className={styles.details}>
+            {notes.map((m) => (
+              <p key={m.seq} className={styles.text}>
+                {m.text}
+              </p>
+            ))}
+            {tools.map((tool) => (
+              <section
+                key={tool.id}
+                className={styles.tool}
+                data-tool-call={tool.id}
+              >
+                <div className={styles.heading}>
+                  <strong>{toolNames[tool.name] ?? "调用工具"}</strong>
+                  <span className={styles.status}>
+                    {tool.state === "running"
+                      ? "执行中"
+                      : tool.state === "failed"
+                        ? "失败"
+                        : "完成"}
+                  </span>
+                </div>
+                <pre className={styles.code}>{tool.input}</pre>
+                {tool.output && (
+                  <pre className={styles.code}>{tool.output}</pre>
+                )}
+              </section>
+            ))}
+          </div>
+        )}
+        {error && (
+          <p role="alert" className={styles.status}>
+            {error}
+          </p>
+        )}
+      </div>
+    </section>
+  );
+}
+function LiveTaskResponse({
+  channelId,
+  message,
+  session,
+}: ComposerAccessoryProps) {
+  const feed = useTaskFeed(channelId);
+  const history = useChannelWindow(session.channels, channelId);
+  const tasks =
+    feed.tasks?.filter((task) => task.source_event_id === message?.id) ?? [];
+  return (
+    <>
+      {tasks.map((task) => (
+        <div key={task.id}>
+          <TaskResponse
+            task={task}
+            represented={
+              !!task.final_event_id &&
+              history.rows.some((row) => row.id === task.final_event_id)
+            }
+          />
+          {feed.error &&
+            ["queued", "running", "waiting_input", "waiting_approval"].includes(
+              task.status,
+            ) && (
+              <div className={styles.status} role="status">
+                {feed.error}
+                <Button variant="ghost" size="caption" onClick={feed.retry}>
+                  重新连接
+                </Button>
+              </div>
+            )}
+        </div>
+      ))}
+    </>
+  );
+}
+const response: Contribution<ComposerAccessory> = {
+  id: "task-progress",
+  key: "team/task-progress",
+  pluginId: "team",
+  revision: "1",
+  title: "Agent 执行过程",
+  placement: "response",
+  component: LiveTaskResponse,
+};
+const none: never[] = [];
+/** Use the existing response accessory host; no second chat or message protocol. */
+export function useTaskExtensions(
+  original: ConversationExtensions | undefined,
+) {
+  return useMemo(() => {
+    if (!teamWeb) return original;
+    const upstream = original?.accessories;
+    let before = upstream?.snapshot(),
+      items = [...(before ?? []), response];
+    return {
+      ...original,
+      tools: original?.tools ?? {
+        snapshot: () => none,
+        subscribe: () => () => {},
+      },
+      inline: original?.inline ?? {
+        snapshot: () => none,
+        subscribe: () => () => {},
+      },
+      accessories: {
+        snapshot: () => {
+          const current = upstream?.snapshot();
+          if (current !== before) {
+            before = current;
+            items = [...(current ?? []), response];
+          }
+          return items;
+        },
+        subscribe: (listener: () => void) =>
+          upstream?.subscribe(listener) ?? (() => {}),
+      },
+    };
+  }, [original]);
+}
