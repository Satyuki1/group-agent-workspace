+/* Network only: never cache authenticated pages, messages, files or API calls. */
+self.addEventListener("install", event => event.waitUntil(self.skipWaiting()));
+self.addEventListener("activate", event => event.waitUntil(self.clients.claim()));
+self.addEventListener("fetch", event => {
+  const url = new URL(event.request.url);
+  if (event.request.mode !== "navigate" || url.origin !== self.location.origin || url.pathname !== "/") return;
+  event.respondWith(fetch(event.request).catch(() => new Response(`<!doctype html>
+<html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+<title>群体智能 · 连接已中断</title>
+<style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f5f5f5;color:#222;font:16px system-ui}main{max-width:28em;padding:32px}h1{font-size:24px}p{line-height:1.8;color:#666}a{color:#c5223a}</style>
+<main><h1>暂时无法连接</h1><p>请确认已连接公司内网。恢复网络后重新打开，查看最新聊天与任务状态。</p><p>离线期间无法发送消息。已提交的远端任务会继续运行。</p><a href="/">重新连接</a></main></html>`, {
+    status: 503,
+    headers: { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store" },
+  })));
+});
