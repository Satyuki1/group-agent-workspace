@@ -0,0 +1,60 @@
+import type { RelaySession } from "../features/relay/session";
+import type { RelayData } from "../features/relay/service";
+import type { Navigation } from "../features/navigation/controller";
+import { splitPartition } from "../features/relay/partition";
+export type Contact = {
+  id: string;
+  name: string;
+  publicKey: string;
+  kind: "person" | "agent";
+  ready: boolean;
+  avatar?: string;
+};
+export async function appCall<T>(
+  path: string,
+  body?: unknown,
+  signal?: AbortSignal,
+): Promise<T> {
+  const headers: Record<string, string> = {};
+  if (body !== undefined) {
+    const response = await fetch("/api/app/auth/me", {
+      ...(signal ? { signal } : {}),
+    });
+    if (!response.ok) throw new Error("登录已失效，请重新登录");
+    headers["X-App-CSRF"] = (await response.json()).csrf;
+    headers["Content-Type"] = "application/json";
+  }
+  const response = await fetch(`/api/app/${path}`, {
+    method: body === undefined ? "GET" : "POST",
+    headers,
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+    ...(signal ? { signal } : {}),
+  });
+  const value = await response.json();
+  if (!response.ok) throw new Error(value.error ?? "操作未完成，请重试");
+  return value;
+}
+export async function openContact(
+  contact: Contact,
+  session: RelaySession,
+  relay: RelayData,
+  navigator: Navigation,
+  signal: AbortSignal,
+) {
+  const id = await session.directMessages.open([contact.publicKey], signal);
+  if (contact.kind === "agent")
+    await appCall(
+      `agents/${contact.id}/conversations`,
+      { conversationId: id },
+      signal,
+    );
+  if (signal.aborted || relay.snapshot().session !== session) return;
+  const scope = splitPartition(session.scope);
+  if (scope)
+    await navigator.open({
+      version: 1,
+      kind: "conversation",
+      channelId: id,
+      scope,
+    });
+}
