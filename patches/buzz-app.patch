+/* IM composition: the sidebar and conversation own their controls. */
+[data-team-shell] .shell-workspace,
+[data-team-shell] .shell-body {
+  padding: 0;
+}
+[data-team-shell] .shell-navigation {
+  background: var(--surface-base);
+  border-inline-end: 1px solid var(--border-standard);
+}
+[data-team-shell] .shell-sidebar {
+  padding: 0;
+}
+[data-team-shell] .shell-sidebar {
+  margin-inline-end: 0;
+}
+[data-team-shell] .shell-history {
+  display: none;
+}
+
+/* The existing unread evidence owns admission; this only colors its mark. */
+[data-team-shell] .shell-navigation [data-channel-priority],
+[data-team-shell] .shell-navigation [data-channel-activity],
+[data-team-shell] .shell-navigation [data-selected] [data-channel-priority],
+[data-team-shell] .shell-navigation [data-selected] [data-channel-activity] {
+  background: var(--status-unread);
+}
