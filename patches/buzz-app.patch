diff --git a/src/team-main.tsx b/src/team-main.tsx
new file mode 100644
index 0000000..86875f1
--- /dev/null
+++ b/src/team-main.tsx
@@ -0,0 +1,112 @@
+import "./shared/styles/globals.css";
+import "@fontsource-variable/inter/wght.css";
+import { useState, type FormEvent } from "react";
+import { createRoot } from "react-dom/client";
+import { Button } from "./shared/design-system/ui/Button";
+import { Input } from "./shared/design-system/ui/Input";
+import { Field } from "./shared/design-system/ui/Field";
+import { Panel } from "./shared/design-system/ui/Panel";
+import "./team-login.css";
+import { TeamSettings } from "./TeamSettings";
+import {APPEARANCE_KEY} from "./shared/theme/service";
+import {ACCENT_KEY,CONTRAST_KEY} from "./shared/theme/accent";
+import teamMark from "./team/mark.svg";
+import { repairTeamEntry } from "./team/entry";
+import "./team/install";
+
+// Team Web starts quietly; later choices remain owned by Buzz Appearance.
+document.documentElement.dataset.teamWeb="";
+try {
+  for(const [key,value] of [[APPEARANCE_KEY,"light"],[ACCENT_KEY,"mono"],[CONTRAST_KEY,"low"]] as const)
+    if(localStorage.getItem(key)===null)localStorage.setItem(key,value);
+} catch { /* Appearance reports unavailable browser storage itself. */ }
+
+async function openApplication() {
+  await import("./main");
+}
+
+const container = document.getElementById("root");
+if (!container) throw new Error("Missing application root");
+
+async function start() {
+  const response = await fetch("/api/app/auth/me");
+  if (response.ok) {
+    const account=await response.json();
+    if (!new URL(location.href).searchParams.has("team-settings")) {
+      let saved = null;
+      try {saved=localStorage.getItem(`buzz-client.v1:${account.user.publicKey}`);} catch { /* Native startup reports unavailable browser storage. */ }
+      const repaired=repairTeamEntry(location.hash,saved,account.user.publicKey,account.relayOrigin);
+      if(repaired)history.replaceState(history.state,"",location.pathname+location.search+repaired);
+      return openApplication();
+    }
+    document.getElementById("buzz-launch")?.remove();
+    container!.removeAttribute("inert");container!.removeAttribute("aria-hidden");
+    createRoot(container!).render(<TeamSettings csrf={account.csrf} role={account.user.role} />);
+    return;
+  }
+  if (response.status !== 401) throw new Error("服务连接失败，请刷新重试");
+  document.getElementById("buzz-launch")?.remove();
+  container!.removeAttribute("inert");
+  container!.removeAttribute("aria-hidden");
+  const root = createRoot(container!);
+  const invite = new URL(location.href).searchParams.get("invite");
+  function Login() {
+    const [register, setRegister] = useState(Boolean(invite));
+    const [busy, setBusy] = useState(false);
+    const [error, setError] = useState("");
+    const [notice, setNotice] = useState("");
+    async function submit(event: FormEvent<HTMLFormElement>) {
+      event.preventDefault();
+      const values = Object.fromEntries(new FormData(event.currentTarget));
+      setError(""); setNotice(""); setBusy(true);
+      try {
+        const result = await fetch(`/api/app/auth/${register ? "register" : "login"}`, {
+          method: "POST", headers: {"Content-Type": "application/json"},
+          body: JSON.stringify({...values, ...(register ? {invite} : {})}),
+        });
+        const data = await result.json();
+        if (!result.ok) throw new Error(data.error ?? "暂时无法登录，请重试");
+        if (register) {
+          setRegister(false);
+          history.replaceState(null, "", location.pathname);
+          setNotice(data.message);
+        } else {
+          // Reload the authenticated entry so deep links keep their destination.
+          location.reload();
+        }
+      } catch (failure) {
+        setError(failure instanceof Error ? failure.message : "网络连接失败，请重试");
+      } finally {setBusy(false);}
+    }
+    return <main className="team-login">
+      <div className="team-login-column">
+        <div className="team-login-brand"><img src={teamMark} alt="" /><span>群体智能</span></div>
+        <Panel shape="card">
+          <form className="team-login-form" onSubmit={submit}>
+            <div><h1>{register ? "加入你的团队" : "一起，把工作做好。"}</h1><p>与同事和 Agent，在同一个对话里协作。</p></div>
+            {register && <Field label="显示名称"><Input name="displayName" required maxLength={60} autoComplete="name" /></Field>}
+            <Field label="账号" description={register ? "3–40 位字母、数字、点、横线或下划线" : undefined}>
+              <Input name="username" required minLength={3} maxLength={40} autoComplete="username" autoCapitalize="none" spellCheck={false} />
+            </Field>
+            <Field label="密码" description={register ? "至少 12 个字符" : undefined}>
+              <Input name="password" type="password" required minLength={12} maxLength={128} autoComplete={register ? "new-password" : "current-password"} />
+            </Field>
+            {error && <p role="alert">{error}</p>}
+            {notice && <p role="status">{notice}</p>}
+            <Button type="submit" variant="prominent" size="lg" loading={busy}>{register ? "创建账号" : "登录"}</Button>
+            <p className="team-login-hint">{register ? "邀请仅供受邀同事使用。" : "首次加入，请向团队管理员获取邀请。"}</p>
+          </form>
+        </Panel>
+      </div>
+    </main>;
+  }
+  root.render(<Login />);
+}
+
+void start().catch(error => {
+  document.getElementById("buzz-launch")?.remove();
+  container.removeAttribute("inert");container.removeAttribute("aria-hidden");
+  const message = document.createElement("p");
+  message.textContent = error instanceof Error ? error.message : "连接失败，请刷新重试";
+  container.append(message);
+});
