+  --team-sidebar-limit: max(220px, calc(100cqi - 336px - var(--team-rail-width)));
+  display: flex;
+  height: 100%;
+  min-height: 0;
+}
+.rail {
+  width: var(--team-rail-width);
+  flex: 0 0 auto;
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  align-items: center;
+  padding-block: var(--space-5) var(--space-3);
+  background: var(--surface-base);
+  border-inline-end: 1px solid var(--border-standard);
+}
+.destinations,
+.account {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: var(--space-3);
+}
+.inventory {
+  display: flex;
+  height: 100%;
+  min-height: 0;
+}
+.directory {
+  width: 300px;
+  max-width: var(--team-sidebar-limit);
+  min-width: 0;
+  height: 100%;
+  background: var(--surface-base);
+}
+.inventory[hidden],
+.directory[hidden] {
+  display: none;
+}
+
+/* The native direct-child clamp must also hold through this composition. */
+/* biome-ignore lint/correctness/noUnknownPseudoClass: host layout targets the existing sidebar role. */
+.inventory > :global(.shell-sidebar),
+/* biome-ignore lint/correctness/noUnknownPseudoClass: connection fallback shares the same width boundary. */
+.inventory > :global(.shell-sidebar-default) {
+  flex: none;
+  max-width: var(--team-sidebar-limit);
+}
