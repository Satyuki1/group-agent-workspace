diff --git a/src/team/GroupTaskActivity.tsx b/src/team/GroupTaskActivity.tsx
new file mode 100644
index 0000000..f3c8da5
--- /dev/null
+++ b/src/team/GroupTaskActivity.tsx
@@ -0,0 +1,250 @@
+import { AgentFace } from "./AgentFace";
+import { useEffect, useRef, useState } from "react";
+import { IconButton } from "../shared/design-system/ui/IconButton";
+import { NavigationItem } from "../shared/design-system/ui/NavigationItem";
+import {
+  PopoverRoot,
+  PopoverTrigger,
+  PopoverPopup,
+  PopoverTitle,
+} from "../shared/design-system/ui/Popover";
+import { StopIcon } from "../shared/design-system/icons";
+import styles from "./GroupTaskActivity.module.css";
+import { useTaskFeed } from "./task-feed";
+
+type Task = {
+  id: string;
+  status: string;
+  agent: string;
+  summary: string;
+  source_event_id: string;
+  thread_root_id: string;
+  cancel_requested: boolean;
+  error: string | null;
+};
+const labels: Record<string, string> = {
+  queued: "排队中",
+  running: "执行中",
+  completed: "已完成",
+  failed: "失败",
+  cancelled: "已停止",
+  needs_review: "需要核对",
+  waiting_input: "等待补充",
+  waiting_approval: "等待确认",
+};
+
+/** A transient activity view; opening a result uses Buzz's existing thread owner. */
+export function GroupTaskActivity({
+  channelId,
+  onOpenThread,
+}: {
+  channelId: string;
+  onOpenThread: (messageId: string, rootId: string) => void;
+}) {
+  const [open, setOpen] = useState(false);
+  const handoff = useRef(false);
+  const activity = useTasks(channelId);
+  const live = useTaskFeed(channelId);
+  const current = live.tasks?.find(task => task.status === "running") ?? live.tasks?.[0];
+  const working =
+    !activity.error &&
+    activity.tasks?.some((task) => ["queued", "running"].includes(task.status));
+  return (
+    <PopoverRoot
+      open={open}
+      onOpenChange={(value) => {
+        handoff.current = false;
+        setOpen(value);
+      }}
+    >
+      <PopoverTrigger
+        render={
+          <IconButton
+            size="sm"
+            variant="ghost"
+            aria-label="群任务"
+            title={working ? "Agent 正在处理 · 查看群任务" : "查看群任务"}
+            icon={
+              <span className={styles.face}>
+                <AgentFace avatar={current?.avatar} working={!!working} />
+              </span>
+            }
+          />
+        }
+      />
+      <PopoverPopup
+        align="end"
+        size="wide"
+        padding="list"
+        aria-label="群任务"
+        finalFocus={() => !handoff.current}
+      >
+        <PopoverTitle>群任务</PopoverTitle>
+        {open && (
+          <TaskList
+            {...activity}
+            onOpen={(id, root) => {
+              handoff.current = true;
+              setOpen(false);
+              onOpenThread(id, root);
+            }}
+          />
+        )}
+      </PopoverPopup>
+    </PopoverRoot>
+  );
+}
+
+function useTasks(channelId: string) {
+  const [tasks, setTasks] = useState<Task[]>();
+  const [error, setError] = useState("");
+  const [pending, setPending] = useState("");
+  const [revision, setRevision] = useState(0);
+  const controller = useRef<AbortController | null>(null);
+  useEffect(() => {
+    const abort = new AbortController();
+    controller.current = abort;
+    let timer: ReturnType<typeof setTimeout>;
+    let refreshing = false;
+    const refresh = async () => {
+      clearTimeout(timer);
+      if (document.hidden || abort.signal.aborted || refreshing) return;
+      refreshing = true;
+      try {
+        const response = await fetch(
+          `/api/app/tasks?conversation=${encodeURIComponent(channelId)}`,
+          { signal: abort.signal },
+        );
+        const value = await response.json();
+        if (!response.ok)
+          throw new Error(value.error ?? "无法刷新任务，请稍后重试");
+        if (!abort.signal.aborted) {
+          setTasks(value.tasks);
+          setError("");
+        }
+      } catch (failure) {
+        if (!abort.signal.aborted)
+          setError(failure instanceof Error ? failure.message : "连接中断");
+      } finally {
+        refreshing = false;
+        if (!abort.signal.aborted)
+          timer = setTimeout(() => void refresh(), 3000);
+      }
+    };
+    const visible = () => {
+      if (!document.hidden) void refresh();
+    };
+    document.addEventListener("visibilitychange", visible);
+    void refresh();
+    return () => {
+      abort.abort();
+      clearTimeout(timer);
+      document.removeEventListener("visibilitychange", visible);
+    };
+  }, [channelId, revision]);
+  async function cancel(id: string) {
+    if (pending) return;
+    setPending(id);
+    setError("");
+    const signal = controller.current?.signal ?? null;
+    try {
+      const account = await fetch("/api/app/auth/me", { signal });
+      if (!account.ok) throw new Error("登录已失效，请刷新后重试");
+      const { csrf } = await account.json();
+      const response = await fetch(`/api/app/tasks/${id}/actions`, {
+        method: "POST",
+        signal,
+        headers: { "Content-Type": "application/json", "X-App-CSRF": csrf },
+        body: JSON.stringify({ action: "cancel" }),
+      });
+      const value = await response.json();
+      if (!response.ok) throw new Error(value.error ?? "未能停止任务，请重试");
+      if (!signal?.aborted) {
+        setTasks((current) =>
+          current?.map((task) =>
+            task.id === id
+              ? { ...task, status: value.status, cancel_requested: true }
+              : task,
+          ),
+        );
+        setRevision((value) => value + 1);
+      }
+    } catch (failure) {
+      if (!signal?.aborted)
+        setError(failure instanceof Error ? failure.message : "连接中断");
+    } finally {
+      if (!signal?.aborted) setPending("");
+    }
+  }
+  return { tasks, error, pending, cancel };
+}
+
+function TaskList({
+  tasks,
+  error,
+  pending,
+  cancel,
+  onOpen,
+}: ReturnType<typeof useTasks> & {
+  onOpen: (id: string, root: string) => void;
+}) {
+  return (
+    <div className={styles.list}>
+      {error && (
+        <p className={styles.notice} role="alert">
+          {error}。显示的是上次取得的状态。
+        </p>
+      )}
+      {!tasks && !error && (
+        <p className={styles.notice} role="status">
+          正在读取任务…
+        </p>
+      )}
+      {tasks?.length === 0 && (
+        <p className={styles.notice}>在群里 @ Agent，任务会显示在这里。</p>
+      )}
+      {tasks?.map((task) => {
+        const active = ["queued", "running", "needs_review"].includes(
+          task.status,
+        );
+        const status =
+          active && task.cancel_requested
+            ? "正在停止"
+            : (labels[task.status] ?? task.status);
+        return (
+          <div key={task.id} className={styles.row} data-task-id={task.id}>
+            <NavigationItem
+              multiline
+              aria-label={`查看任务：${task.summary}`}
+              onClick={() => onOpen(task.source_event_id, task.thread_root_id)}
+              label={
+                <span className={styles.body}>
+                  <span className={styles.heading}>
+                    {task.agent}
+                    <span className={styles.meta}>{status}</span>
+                  </span>
+                  <span className={styles.summary}>{task.summary}</span>
+                  {task.error && task.status !== "cancelled" && (
+                    <span className={styles.meta}>{task.error}</span>
+                  )}
+                </span>
+              }
+            />
+            {active && (
+              <IconButton
+                size="sm"
+                variant="ghost"
+                icon={<StopIcon />}
+                aria-label={`停止任务：${task.summary}`}
+                title="停止任务，保留已生成的文件"
+                disabled={!!pending || task.cancel_requested}
+                loading={pending === task.id}
+                onClick={() => void cancel(task.id)}
+              />
+            )}
+          </div>
+        );
+      })}
+    </div>
+  );
+}
