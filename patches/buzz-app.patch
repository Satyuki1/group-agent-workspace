+import {readFileSync} from 'node:fs';
+import {parse} from '@babel/parser';
+
+const copy=JSON.parse(readFileSync(new URL('./team-web-copy.json',import.meta.url),'utf8'));
+const properties=new Set(['label','title','subtitle','description','placeholder','aria-label','aria-description','closeLabel','emptyLabel','loadingLabel','menuLabel','alt','message','text','hint']);
+const segments={'View ':'查看',' profile':'的资料','Send a message to ':'发消息给 ','Conversation in ':'所在聊天：','Close ':'关闭 ',' tab':'标签','Reply to ':'回复 ','Remove mention ':'移除提及 ','View thread: ':'查看讨论：',' replies':' 条回复',' reply':' 条回复','Added by ':'添加者：',' added by ':' 由以下成员添加：',' along with ':'，还有 ','You and ':'你与 ',' and ':'和','Typing in ':'正在输入：'};
+function translate(value) {
+  const exact=copy[value]??segments[value];
+  if(exact)return exact;
+  const trimmed=copy[value.trim()];
+  if(trimmed)return value.replace(value.trim(),trimmed);
+  if(/[\u4e00-\u9fff]/.test(value) && /Agent|Harness 工作面/.test(value))return value.replace(/Agent/g,'智能体').replace(/Harness 工作面/g,'工作面');
+}
+
+/** Localize product copy in the Team Web artifact; protocol ids and user data are untouched. */
+export function localizeTeamWeb(code,id,inventory) {
+  if(!/\.[jt]sx(?:\?|$)/.test(id) || !id.includes('/src/') || /(?:\.test\.|\/design-system\/icons\/)/.test(id))return;
+  const ast=parse(code,{sourceType:'module',plugins:['typescript',...(/\.[jt]sx(?:\?|$)/.test(id)?['jsx']:[])]}),changes=[];
+  function visible(node,parents) {
+    let child=node;
+    for(let index=parents.length-1;index>=0;index--){
+      const parent=parents[index];
+      if(parent.type==='JSXAttribute')return properties.has(parent.name?.name) && parent.value===child;
+      if(parent.type==='JSXExpressionContainer'){
+        const owner=parents[index-1];
+        return owner?.type==='JSXAttribute'?properties.has(owner.name?.name):true;
+      }
+      if(parent.type==='ConditionalExpression' && (child===parent.consequent || child===parent.alternate)
+        || parent.type==='LogicalExpression' && child===parent.right
+        || parent.type==='ParenthesizedExpression' || parent.type==='TSAsExpression'
+        || parent.type==='TemplateLiteral' && parent.expressions.includes(child)) {child=parent;continue;}
+      return false;
+    }
+    return false;
+  }
+  function visit(node,parents=[]) {
+    if(!node || typeof node!=='object')return;
+    let value,translated;
+    if(node.type==='JSXText') {
+      value=node.value.trim().replace(/\s+/g,' ');
+      translated=translate(node.value);
+      if(!translated && copy[value])translated=node.value.replace(node.value.trim(),copy[value]);
+      if(translated)changes.push([node.start,node.end,translated]);
+      else if(/[A-Za-z]{2}/.test(value))inventory?.add(value);
+    } else if(node.type==='StringLiteral' && visible(node,parents)) {
+      value=node.value;translated=translate(value);
+      if(translated)changes.push([node.start,node.end,JSON.stringify(translated)]);
+      else if(/[A-Za-z]{2}/.test(value) && !/^(?:https?:|\/|data:|var\(|#|[a-z]+[-_.][a-z]+|[\w]+Icon$)/.test(value))inventory?.add(value);
+    } else if(node.type==='TemplateLiteral' && visible(node,parents)) {
+      for(const quasi of node.quasis){
+        const raw=quasi.value.raw;
+        const next=translate(raw);
+        if(next)changes.push([quasi.start,quasi.end,next]);
+        else if(/[A-Za-z]{2}/.test(raw))inventory?.add(raw);
+      }
+    }
+    for(const [key,value]of Object.entries(node)){
+      if(['loc','start','end','extra','comments','tokens'].includes(key))continue;
+      if(Array.isArray(value))for(const child of value)visit(child,[...parents,node]);
+      else if(value && typeof value==='object')visit(value,[...parents,node]);
+    }
+  }
+  visit(ast);
+  if(!changes.length)return;
+  let end=code.length;
+  for(const [start,stop,value]of changes.sort((a,b)=>b[0]-a[0])){
+    if(stop>end)continue;
+    code=code.slice(0,start)+value+code.slice(stop);end=start;
+  }
+  return {code,map:null};
+}
+export function teamWebLocale(){return {name:'team-web-chinese',enforce:'pre',transform(code,id){return localizeTeamWeb(code,id);}};}
