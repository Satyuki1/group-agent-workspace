+import { useState, type ReactNode } from "react";
+import type { RelayData } from "../features/relay/service";
+import type { Navigation } from "../features/navigation/controller";
+import { IconButton } from "../shared/design-system/ui/IconButton";
+import {
+  BellIcon,
+  ChatCircleIcon,
+  UsersIcon,
+} from "../shared/design-system/icons";
+import { useTeamAccount } from "./TeamAccountContext";
+import { TeamContacts } from "./TeamContacts";
+import { InstallApp } from "./InstallApp";
+import styles from "./TeamSidebar.module.css";
+
+/** Directory is a sidebar view: switching it preserves the open chat and draft. */
+export function TeamSidebar({
+  relay,
+  navigator,
+  children,
+}: {
+  relay: RelayData;
+  navigator: Navigation;
+  children: ReactNode;
+}) {
+  const account = useTeamAccount();
+  const [contacts, setContacts] = useState(false);
+  return (
+    <div className={styles.sidebar} data-team-navigation="">
+      <nav className={styles.rail} aria-label="主导航">
+        <div className={styles.destinations}>
+          <IconButton
+            aria-label="聊天"
+            title="聊天"
+            size="lg"
+            shape="round"
+            variant={contacts ? "ghost" : "prominent"}
+            aria-pressed={!contacts}
+            icon={<ChatCircleIcon size={22} />}
+            onClick={() => setContacts(false)}
+          />
+          <IconButton
+            aria-label="通讯录"
+            title="通讯录"
+            size="lg"
+            shape="round"
+            variant={contacts ? "prominent" : "ghost"}
+            aria-pressed={contacts}
+            icon={<UsersIcon size={22} />}
+            onClick={() => setContacts(true)}
+          />
+        </div>
+        <div className={styles.account}>
+          <InstallApp />
+          <IconButton
+            aria-label="通知与声音"
+            title="通知与声音"
+            size="lg"
+            shape="round"
+            variant="ghost"
+            icon={<BellIcon size={21} />}
+            onClick={() =>
+              void navigator.open({
+                version: 1,
+                kind: "settings",
+                section: "notifications",
+              })
+            }
+          />
+          {account}
+        </div>
+      </nav>
+      <div className={styles.inventory} hidden={contacts}>
+        {children}
+      </div>
+      <div className={styles.directory} hidden={!contacts}>
+        <TeamContacts
+          relay={relay}
+          navigator={navigator}
+          active={contacts}
+          onOpenChat={() => setContacts(false)}
+        />
+      </div>
+    </div>
+  );
+}
