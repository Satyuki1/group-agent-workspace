+// @vitest-environment jsdom
+import "@testing-library/jest-dom/vitest";
+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+import type { RelayData } from "../features/relay/service";
+import type { Navigation } from "../features/navigation/controller";
+import { TeamSidebar } from "./TeamSidebar";
+import { appCall, openContact } from "./im-api";
+
+vi.mock("./im-api", () => ({ appCall: vi.fn(), openContact: vi.fn() }));
+afterEach(() => { cleanup(); vi.resetAllMocks(); });
+
+const connection = { session: {} };
+const relay = { subscribe: () => () => {}, snapshot: () => connection } as unknown as RelayData;
+const agent = {id: "a", name: "写作员", kind: "agent", ready: true, avatar: "bloom-prism"};
+function mount() {
+  const open = vi.fn().mockResolvedValue({status: "opened"});
+  render(<TeamSidebar relay={relay} navigator={{open} as unknown as Navigation}>
+    <input aria-label="聊天草稿" defaultValue="尚未发送" />
+  </TeamSidebar>);
+  return open;
+}
+
+it("switches directory without losing the chat draft, opens contacts through the existing host, and enters real notification settings", async () => {
+  vi.mocked(appCall).mockResolvedValue({people: [], agents: [agent]});
+  const open = mount();
+  const draft = screen.getByLabelText("聊天草稿");
+  fireEvent.click(screen.getByRole("button", {name: "通讯录"}));
+  expect(draft).not.toBeVisible();
+  fireEvent.click(await screen.findByRole("button", {name: "与写作员聊天"}));
+  await waitFor(() => expect(draft).toBeVisible());
+  expect(draft).toHaveValue("尚未发送");
+  expect(openContact).toHaveBeenCalledWith(agent, connection.session, relay, expect.anything(), expect.any(AbortSignal));
+  fireEvent.click(screen.getByRole("button", {name: "通知与声音"}));
+  expect(open).toHaveBeenCalledWith({version: 1, kind: "settings", section: "notifications"});
+});
+
+it("cancels an old directory request when switching away and does not adopt its late result", async () => {
+  let resolve!: (value: unknown) => void;
+  vi.mocked(appCall).mockImplementationOnce(() => new Promise(done => { resolve = done; }));
+  mount();
+  fireEvent.click(screen.getByRole("button", {name: "通讯录"}));
+  const signal = vi.mocked(appCall).mock.calls[0]?.[2];
+  fireEvent.click(screen.getByRole("button", {name: "聊天"}));
+  expect(signal?.aborted).toBe(true);
+  resolve({people: [], agents: [agent]});
+  vi.mocked(appCall).mockResolvedValue({people: [], agents: []});
+  fireEvent.click(screen.getByRole("button", {name: "通讯录"}));
+  await screen.findByText("没有找到联系人");
+  expect(screen.queryByRole("button", {name: "与写作员聊天"})).not.toBeInTheDocument();
+});
