+import { Button } from "../shared/design-system/ui/Button";
+import { AgentFace } from "./AgentFace";
+import { useTaskFeed } from "./task-feed";
+import styles from "./WorkingAgents.module.css";
+
+export const liveWorkspaceEvent = "team-work-live";
+/** Shared server state, grouped by identity rather than by browser or thread. */
+export function WorkingAgents({ channelId }: { channelId: string }) {
+  const { tasks, error } = useTaskFeed(channelId);
+  const active = (tasks ?? []).filter(task => ["running", "queued"].includes(task.status))
+    .sort((a, b) => Number(b.status === "running") - Number(a.status === "running"))
+    .filter((task, index, list) => list.findIndex(other => other.public_key === task.public_key) === index);
+  if (!active.length || error) return null;
+  return <div className={styles.bar} data-working-agents="" role="status">
+    <span className={styles.avatars}>{active.map(task => <span className={styles.avatar} key={task.public_key} title={`${task.agent} · ${task.status === "queued" ? "排队中" : "正在工作"}`}><AgentFace avatar={task.avatar} working={task.status === "running"} /></span>)}</span>
+    <span className={styles.label}>{active.map(task => task.agent).join("、")}<span className={styles.muted}>{active.every(task => task.status === "queued") ? " 正在排队" : " 正在工作"}</span></span>
+    <Button variant="ghost" size="caption" onClick={() => window.dispatchEvent(new CustomEvent(liveWorkspaceEvent, { detail: channelId }))}>查看直播</Button>
+  </div>;
+}
