diff --git a/src/team/TeamNewMenu.tsx b/src/team/TeamNewMenu.tsx
new file mode 100644
index 0000000..6f50202
--- /dev/null
+++ b/src/team/TeamNewMenu.tsx
@@ -0,0 +1,317 @@
+import { createPortal } from "react-dom";
+import { useEffect, useRef, useState, type RefObject } from "react";
+import type { RelayData } from "../features/relay/service";
+import type { Navigation } from "../features/navigation/controller";
+import { useRelayConnection } from "../features/relay/react";
+import {
+  MenuRoot,
+  MenuTrigger,
+  MenuPopup,
+  MenuItem,
+  MenuIcon,
+} from "../shared/design-system/ui/Menu";
+import { IconButton } from "../shared/design-system/ui/IconButton";
+import {
+  PlusIcon,
+  UsersIcon,
+  RobotIcon,
+  CheckIcon,
+} from "../shared/design-system/icons";
+import { Dialog } from "../shared/design-system/ui/Dialog";
+import { Field } from "../shared/design-system/ui/Field";
+import { Input } from "../shared/design-system/ui/Input";
+import { Textarea } from "../shared/design-system/ui/Textarea";
+import { Button } from "../shared/design-system/ui/Button";
+import { NavigationItem } from "../shared/design-system/ui/NavigationItem";
+import { SearchField } from "../shared/design-system/ui/SearchField";
+import { revealCreatedChannel } from "../features/channel-navigation/created-channel";
+import { appCall, openContact, type Contact } from "./im-api";
+import styles from "./TeamIM.module.css";
+import { AgentAvatarPicker } from "./AgentAvatarPicker";
+
+type Props = {
+  relay: RelayData;
+  navigator: Navigation;
+  triggerContainer?: HTMLElement | null;
+  open?: boolean;
+  onOpenChange?: (open: boolean) => void;
+};
+export function TeamNewMenu({
+  relay,
+  navigator,
+  triggerContainer,
+  open,
+  onOpenChange,
+}: Props) {
+  const connection = useRelayConnection(relay),
+    trigger = useRef<HTMLButtonElement>(null);
+  const [creating, setCreating] = useState<"group" | "agent">();
+  const action = (
+    <MenuTrigger
+      render={
+        <IconButton
+          ref={trigger}
+          aria-label="添加"
+          title="添加"
+          variant="inset"
+          shape="round"
+          size="lg"
+          disabled={connection.status !== "ready"}
+          icon={<PlusIcon size={22} />}
+        />
+      }
+    />
+  );
+  return (
+    <>
+      <MenuRoot open={open} onOpenChange={onOpenChange}>
+        {triggerContainer === undefined
+          ? action
+          : triggerContainer && createPortal(action, triggerContainer)}
+        <MenuPopup align="end" aria-label="添加">
+          <MenuItem onClick={() => setCreating("group")}>
+            <MenuIcon>
+              <UsersIcon />
+            </MenuIcon>
+            创建群聊
+          </MenuItem>
+          <MenuItem onClick={() => setCreating("agent")}>
+            <MenuIcon>
+              <RobotIcon />
+            </MenuIcon>
+            创建智能体
+          </MenuItem>
+        </MenuPopup>
+      </MenuRoot>
+      {creating && (
+        <CreateChat
+          key={creating}
+          kind={creating}
+          relay={relay}
+          navigator={navigator}
+          close={() => setCreating(undefined)}
+          trigger={trigger}
+        />
+      )}
+    </>
+  );
+}
+function CreateChat({
+  kind,
+  relay,
+  navigator,
+  close,
+  trigger,
+}: {
+  kind: "group" | "agent";
+  relay: RelayData;
+  navigator: Navigation;
+  close: () => void;
+  trigger: RefObject<HTMLButtonElement | null>;
+}) {
+  const { session } = useRelayConnection(relay);
+  const [name, setName] = useState(""),
+    [avatar, setAvatar] = useState("spark-rose"),
+    [instructions, setInstructions] = useState(""),
+    [search, setSearch] = useState("");
+  const [contacts, setContacts] = useState<Contact[]>(),
+    [selected, setSelected] = useState<string[]>([]),
+    [error, setError] = useState(""),
+    [busy, setBusy] = useState(false);
+  const request = useRef(new AbortController()),
+    creationId = useRef(crypto.randomUUID()),
+    groupId = useRef(""),
+    added = useRef(new Set<string>());
+  useEffect(() => {
+    const controller = new AbortController();
+    request.current = controller;
+    if (kind === "group")
+      void appCall<{ people: Contact[]; agents: Contact[] }>(
+        "directory",
+        undefined,
+        controller.signal,
+      )
+        .then((data) =>
+          setContacts([...data.people, ...data.agents].filter((c) => c.ready)),
+        )
+        .catch((e) => {
+          if (!controller.signal.aborted) setError(e.message);
+        });
+    return () => controller.abort();
+  }, [kind]);
+  async function create() {
+    if (busy || !name.trim()) return;
+    const signal = request.current.signal;
+    setBusy(true);
+    setError("");
+    try {
+      if (kind === "agent") {
+        let contact = await appCall<Contact>(
+          "agents",
+          {
+            id: creationId.current,
+            name: name.trim(),
+            avatar,
+            instructions:
+              instructions.trim() ||
+              "你是一位工作助手，帮助我梳理问题、完成任务，用中文简洁沟通。",
+          },
+          signal,
+        );
+        if (!contact.ready)
+          throw new Error(
+            "Agent 正在创建。请稍后点一次创建以继续，不会重复创建。",
+          );
+        await openContact(contact, session, relay, navigator, signal);
+      } else {
+        if (!groupId.current)
+          groupId.current = await session.channelCreation.create({
+            name: name.trim(),
+            visibility: "private",
+          });
+        for (const contact of (contacts ?? []).filter(
+          (c) => selected.includes(c.id) && !added.current.has(c.id),
+        )) {
+          if (contact.kind === "agent")
+            await appCall(
+              `agents/${contact.id}/conversations`,
+              { conversationId: groupId.current },
+              signal,
+            );
+          else
+            await session.memberAdditions.add(
+              groupId.current,
+              contact.publicKey,
+            );
+          added.current.add(contact.id);
+        }
+        revealCreatedChannel(
+          relay,
+          session,
+          navigator,
+          { name: name.trim(), visibility: "private" },
+          groupId.current,
+        );
+      }
+      if (!signal.aborted) close();
+    } catch (e) {
+      if (!signal.aborted)
+        setError(e instanceof Error ? e.message : "未能完成创建，请重试");
+    } finally {
+      if (!signal.aborted) setBusy(false);
+    }
+  }
+  return (
+    <Dialog
+      open
+      onOpenChange={(value) => {
+        if (!value) close();
+      }}
+      title={kind === "group" ? "创建群聊" : "创建智能体"}
+      size="compact"
+      finalFocus={trigger}
+      preventClose={busy}
+      closeLabel="关闭"
+      actions={
+        <>
+          <Button variant="ghost" disabled={busy} onClick={close}>
+            取消
+          </Button>
+          <Button
+            variant="prominent"
+            loading={busy}
+            disabled={!name.trim() || (kind === "group" && !contacts)}
+            onClick={() => void create()}
+          >
+            {groupId.current ? "完成添加" : "创建"}
+          </Button>
+        </>
+      }
+    >
+      <form
+        className={styles.form}
+        onSubmit={(event) => {
+          event.preventDefault();
+          void create();
+        }}
+      >
+        {kind === "agent" && <AgentAvatarPicker value={avatar} onChange={setAvatar} disabled={busy} />}
+        <Field label={kind === "group" ? "群聊名称" : "智能体名称"}>
+          <Input
+            autoFocus
+            value={name}
+            onValueChange={setName}
+            required
+            maxLength={40}
+            placeholder={kind === "group" ? "给群聊起个名字" : "例如：调研助手"}
+            disabled={busy || !!groupId.current}
+          />
+        </Field>
+        {kind === "agent" ? (
+          <Field label="它可以帮你做什么" description="可以以后再完善。">
+            <Textarea
+              value={instructions}
+              onChange={(event) => setInstructions(event.target.value)}
+              rows={4}
+              maxLength={4000}
+              placeholder="例如：整理资料、分析问题、撰写方案…"
+              disabled={busy}
+            />
+          </Field>
+        ) : (
+          <>
+            <SearchField
+              label="选择成员"
+              placeholder="搜索同事或 Agent"
+              value={search}
+              onValueChange={setSearch}
+              disabled={busy}
+            />
+            {!contacts && !error && <p role="status">正在读取联系人…</p>}
+            <div className={styles.picker}>
+              {contacts
+                ?.filter((c) =>
+                  c.name
+                    .toLocaleLowerCase()
+                    .includes(search.toLocaleLowerCase()),
+                )
+                .map((contact) => (
+                  <NavigationItem
+                    key={contact.id}
+                    variant="option"
+                    aria-pressed={selected.includes(contact.id)}
+                    disabled={busy}
+                    selected={selected.includes(contact.id)}
+                    label={contact.name}
+                    trailing={
+                      selected.includes(contact.id) ? (
+                        <CheckIcon size={16} />
+                      ) : undefined
+                    }
+                    onClick={() =>
+                      setSelected((list) =>
+                        list.includes(contact.id)
+                          ? list.filter((id) => id !== contact.id)
+                          : [...list, contact.id],
+                      )
+                    }
+                  />
+                ))}
+            </div>
+            <p className={styles.meta}>
+              {selected.length
+                ? `已选择 ${selected.length} 位成员`
+                : "可以先创建群聊，稍后再邀请成员。"}
+            </p>
+          </>
+        )}
+        {error && (
+          <p role="alert" className={styles.notice}>
+            {groupId.current ? "群聊已经创建，部分成员尚未加入。" : ""}
+            {error}
+          </p>
+        )}
+      </form>
+    </Dialog>
+  );
+}
