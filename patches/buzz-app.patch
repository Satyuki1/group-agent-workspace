@@ -0,0 +1,67 @@
+import type { ChannelSummary } from "../features/relay/contracts";
+
+export const teamWeb = import.meta.env.VITE_TEAM_WEB === "1";
+export const clockLabel = (seconds: number) =>
+  new Intl.DateTimeFormat("zh-CN", {
+    hour: "2-digit",
+    minute: "2-digit",
+    hour12: false,
+  }).format(seconds * 1000);
+export function dayLabel(seconds: number, now = new Date()) {
+  const date = new Date(seconds * 1000);
+  const key = (value: Date) =>
+    `${value.getFullYear()}-${value.getMonth()}-${value.getDate()}`;
+  if (key(date) === key(now)) return "今天";
+  const yesterday = new Date(now);
+  yesterday.setDate(now.getDate() - 1);
+  if (key(date) === key(yesterday)) return "昨天";
+  return new Intl.DateTimeFormat("zh-CN", {
+    month: "short",
+    day: "numeric",
+    ...(date.getFullYear() !== now.getFullYear()
+      ? { year: "numeric" as const }
+      : {}),
+  }).format(date);
+}
+export function recentLabel(seconds: number | undefined) {
+  if (!seconds) return "";
+  const day = dayLabel(seconds);
+  return day === "今天" ? clockLabel(seconds) : day;
+}
+export function recentConversations(
+  sections: readonly { key: string; rows: readonly ChannelSummary[] }[],
+  search: string,
+) {
+  const rows = new Map<
+    string,
+    { channel: ChannelSummary; sectionKey: string }
+  >();
+  for (const section of sections)
+    for (const channel of section.rows)
+      if (!rows.has(channel.id))
+        rows.set(channel.id, { channel, sectionKey: section.key });
+  const term = search.trim().toLocaleLowerCase();
+  return [...rows.values()]
+    .filter(
+      ({ channel }) =>
+        !term ||
+        `${channel.name} ${channel.preview ?? ""}`
+          .toLocaleLowerCase()
+          .includes(term),
+    )
+    .sort(
+      (a, b) =>
+        Number(b.sectionKey === "starred") -
+          Number(a.sectionKey === "starred") ||
+        (b.channel.lastActivityAt ?? 0) - (a.channel.lastActivityAt ?? 0) ||
+        a.channel.id.localeCompare(b.channel.id),
+    );
+}
+
+/** A one-line reading preview, not another Markdown renderer. */
+export const chatPreview = (value: string) =>
+  value
+    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
+    .replace(/\*\*([^*]+)\*\*/g, "$1")
+    .replace(/`([^`]+)`/g, "$1")
+    .replace(/\s+/g, " ");
diff --git a/src/team/task-feed.ts b/src/team/task-feed.ts
new file mode 100644
index 0000000..f42ec5d
--- /dev/null
+++ b/src/team/task-feed.ts
@@ -0,0 +1,149 @@
+import { useMemo, useSyncExternalStore } from "react";
+export type TaskProgress = {
+  phase?: string;
+  text?: string;
+  updatedAt?: string;
+  tools?: {
+    id: string;
+    name: string;
+    input: string;
+    state: string;
+    output?: string;
+    completedAt?: number;
+    resource?: {kind: "browser"; url: string};
+  }[];
+  messages?: { seq: number; text: string }[];
+};
+export type LiveTask = {
+  id: string;
+  status: string;
+  created_at: string;
+  agent: string;
+  public_key: string;
+  avatar?: string;
+  final_event_id?: string | null;
+  source_event_id: string;
+  thread_root_id: string;
+  summary: string;
+  cancel_requested: boolean;
+  error: string | null;
+  progress: TaskProgress;
+};
+type Snapshot = { tasks?: LiveTask[]; error: string; resourcesAfter?: number | undefined };
+const feeds = new Map<string, ReturnType<typeof createFeed>>();
+function createFeed(channelId: string) {
+  let snapshot: Snapshot = { error: "" },
+    source: EventSource | undefined;
+  const listeners = new Set<() => void>();
+  const publish = (next: Snapshot) => {
+    snapshot = next;
+    for (const listener of listeners) listener();
+  };
+  function offline() {
+    source?.close();
+    source = undefined;
+    publish({
+      ...snapshot,
+      error: "进度连接中断，正在重连；远端任务仍可能在执行",
+    });
+  }
+  const online = () => {
+    if (listeners.size) connect();
+  };
+  function connect() {
+    if (navigator.onLine === false) {
+      offline();
+      return;
+    }
+    source?.close();
+    const current = new EventSource(
+      `/api/app/conversations/${encodeURIComponent(channelId)}/activity`,
+    );
+    source = current;
+    current.onmessage = (event) => {
+      if (source !== current) return;
+      try {
+        const update = JSON.parse(event.data) as {
+          reset: boolean;
+          serverTime?: number;
+          tasks: LiveTask[];
+          removed?: string[];
+        };
+        const tasks = new Map(
+          (update.reset ? [] : (snapshot.tasks ?? [])).map((task) => [
+            task.id,
+            task,
+          ]),
+        );
+        for (const task of update.tasks) tasks.set(task.id, task);
+        for (const id of update.removed ?? []) tasks.delete(id);
+        publish({
+          resourcesAfter: snapshot.resourcesAfter ?? update.serverTime,
+          tasks: [...tasks.values()]
+            .sort(
+              (a, b) =>
+                Number(b.status === "running") - Number(a.status === "running") ||
+                new Date(b.created_at).getTime() -
+                new Date(a.created_at).getTime(),
+            )
+            .slice(0, 30),
+          error: "",
+        });
+      } catch {
+        publish({ ...snapshot, error: "进度连接异常，请重新连接" });
+      }
+    };
+    current.onerror = () => {
+      if (source === current)
+        publish({
+          ...snapshot,
+          error: "进度连接中断，正在重连；远端任务仍可能在执行",
+        });
+    };
+    current.addEventListener("revoked", () => {
+      if (source === current) {
+        current.close();
+        publish({ tasks: [], error: "工作空间访问已失效" });
+      }
+    });
+  }
+  return {
+    snapshot: () => snapshot,
+    retry: connect,
+    subscribe(listener: () => void) {
+      listeners.add(listener);
+      if (listeners.size === 1) {
+        window.addEventListener("offline", offline);
+        window.addEventListener("online", online);
+        connect();
+      }
+      return () => {
+        listeners.delete(listener);
+        if (!listeners.size) {
+          window.removeEventListener("offline", offline);
+          window.removeEventListener("online", online);
+          source?.close();
+          source = undefined;
+          snapshot = { error: "" };
+          queueMicrotask(() => {
+            if (!listeners.size) feeds.delete(channelId);
+          });
+        }
+      };
+    },
+  };
+}
+export function useTaskFeed(channelId: string) {
+  const feed = useMemo(() => {
+    let value = feeds.get(channelId);
+    if (!value) {
+      value = createFeed(channelId);
+      feeds.set(channelId, value);
+    }
+    return value;
+  }, [channelId]);
+  return {
+    ...useSyncExternalStore(feed.subscribe, feed.snapshot, feed.snapshot),
+    retry: feed.retry,
+  };
+}
