+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {localizeTeamWeb} from './team-web-locale.mjs';
+
+test('localizes labels and interpolated profile hints without changing protocol roles, MIME values or user data',()=>{
+  const code='const role="member";const mime="Files";const userText=message.content;const item={id:"settings",label:"Settings"};export const UI=()=> <button aria-label={`View ${name} profile`} onClick={()=>send({kind:"agent",text:userText})}>Reply</button>;';
+  const result=localizeTeamWeb(code,'/app/src/Test.tsx').code;
+  assert.match(result,/label:"Settings"/);assert.match(result,/>回复</);assert.match(result,/`查看\$\{name\}的资料`/);
+  assert.match(result,/role="member"/);assert.match(result,/mime="Files"/);assert.match(result,/text:userText/);
+});
+test('keeps formatting command ids, state comparisons and protocol returns stable inside rendered expressions',()=>{
+  const code='const label="Link";const group={name:"Your agents"};const x={label:"Bold"};function event(){return "edited";}export const UI=()=> <button aria-label={label === "Link" ? "Insert link" : "More"}>{status === "Link copied" ? "Link copied" : "Copy link"}{group.name === "Your agents" && <span>Agents</span>}</button>;';
+  const result=localizeTeamWeb(code,'/app/src/Test.tsx').code;
+  assert.match(result,/label === "Link"/);assert.match(result,/status === "Link copied"/);assert.match(result,/group.name === "Your agents"/);
+  assert.match(result,/return "edited"/);assert.match(result,/label:"Bold"/);assert.match(result,/\? "链接已复制" : "复制链接"/);
+});
+test('leaves non-client code and unknown literals intact',()=>{
+  assert.equal(localizeTeamWeb('const a="Settings"','/app/scripts/a.ts'),undefined);
+  assert.equal(localizeTeamWeb('export const UI=()=> <p>{"customer-defined-name"}</p>;','/app/src/Test.tsx'),undefined);
+});
diff --git a/src/TeamSettings.tsx b/src/TeamSettings.tsx
new file mode 100644
index 0000000..e7feede
--- /dev/null
+++ b/src/TeamSettings.tsx
@@ -0,0 +1,64 @@
+import { useEffect, useState, type FormEvent } from "react";
+import { Button } from "./shared/design-system/ui/Button";
+import { Input } from "./shared/design-system/ui/Input";
+import { Field } from "./shared/design-system/ui/Field";
+import { Panel } from "./shared/design-system/ui/Panel";
+
+export function TeamSettings({csrf,role}:{csrf:string;role:string}) {
+  const [status,setStatus]=useState("");
+  const [busy,setBusy]=useState(false);
+  const [invitation,setInvitation]=useState("");
+  const [model,setModel]=useState<{configured:boolean;managedByEnvironment:boolean;models:string[];verifiedAt:string|null}|null>(null);
+  useEffect(()=>{
+    if(role!=="admin")return;
+    const controller=new AbortController();
+    void fetch("/api/app/settings/model",{signal:controller.signal}).then(async response=>{
+      if(!response.ok)throw new Error("无法读取模型配置，请刷新重试");
+      setModel(await response.json());
+    }).catch(error=>{if(!controller.signal.aborted)setStatus(error.message);});
+    return ()=>controller.abort();
+  },[role]);
+  async function call(path:string,body:unknown) {
+    const response=await fetch(`/api/app/${path}`,{method:"POST",headers:{"Content-Type":"application/json","X-App-CSRF":csrf},body:JSON.stringify(body)});
+    const value=await response.json();
+    if(!response.ok)throw new Error(value.error??"操作失败，请稍后重试");
+    return value;
+  }
+  async function saveModel(event:FormEvent<HTMLFormElement>) {
+    event.preventDefault();const form=event.currentTarget;
+    setBusy(true);setStatus("");
+    try {
+      const data=await call("settings/model",Object.fromEntries(new FormData(form)));
+      form.reset();setModel({...data,managedByEnvironment:false});setStatus("验证成功，已保存");
+    } catch(error){setStatus(error instanceof Error?error.message:"连接失败");}
+    finally {setBusy(false);}
+  }
+  async function invite() {
+    setBusy(true);setStatus("");
+    try {const value=await call("auth/invitations",{});setInvitation(value.url);}
+    catch(error){setStatus(error instanceof Error?error.message:"创建失败");}
+    finally {setBusy(false);}
+  }
+  async function logout() {await call("auth/logout",{});location.href="/";}
+  return <main className="team-login"><div className="team-login-column">
+    <div className="team-login-brand">团队设置</div>
+    <Panel shape="card"><div className="team-login-form">
+      {role==="admin" && <>
+        <form className="team-settings-section" onSubmit={saveModel}>
+          <h1>模型</h1>
+          {model?.configured && <p>已配置 DeepSeek{model.verifiedAt ? "，验证通过" : ""}{model.models.length ? `。可用模型：${model.models.join("、")}` : ""}</p>}
+          {model?.managedByEnvironment ? <p>由服务器环境变量管理</p> : <>
+            <Field label="DeepSeek API Key" description="仅保存于服务器；保存时会验证账号和可用模型。"><Input name="apiKey" type="password" required minLength={20} maxLength={300} autoComplete="off" disabled={model===null} /></Field>
+            <Button type="submit" variant="prominent" loading={busy} disabled={model===null}>验证并保存</Button>
+          </>}
+        </form>
+        <div className="team-settings-section"><h1>邀请同事</h1><Button onClick={()=>void invite()} loading={busy}>创建邀请链接</Button>
+          {invitation && <Field label="邀请链接" description="7 天内有效，仅可使用一次。"><Input value={invitation} readOnly onFocus={e=>e.target.select()} /></Field>}
+        </div>
+      </>}
+      {status && <p role="status">{status}</p>}
+      <Button onClick={()=>{location.href="/";}}>返回聊天</Button>
+      <Button variant="ghost" onClick={()=>void logout()}>退出登录</Button>
+    </div></Panel>
+  </div></main>;
+}
