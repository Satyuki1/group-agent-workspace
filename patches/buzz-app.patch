@@ -0,0 +1,61 @@
+import { useEffect, useId, useState } from "react";
+import { avatarPaths, avatarPreset } from "./avatar-presets";
+import styles from "./AgentFace.module.css";
+
+/** Team's character artwork; motion is decorative, status is supplied in text. */
+export function AgentFace({
+  working = false,
+  kind = "agent",
+  avatar,
+}: {
+  working?: boolean;
+  kind?: "agent" | "group";
+  avatar?: string | undefined;
+}) {
+  const id = useId();
+  const { shape, palette } = avatarPreset(avatar);
+  const [visible, setVisible] = useState(() => !document.hidden);
+  useEffect(() => {
+    const update = () => setVisible(!document.hidden);
+    document.addEventListener("visibilitychange", update);
+    return () => document.removeEventListener("visibilitychange", update);
+  }, []);
+  return (
+    <span
+      className={styles.face}
+      data-working={working || undefined}
+      data-paused={!visible || undefined}
+      data-kind={kind}
+      aria-hidden="true"
+    >
+      <svg viewBox="0 0 40 40" focusable="false">
+        <defs><linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
+          {palette.colors.map((color, index) => <stop key={color} offset={`${index / (palette.colors.length - 1) * 100}%`} stopColor={color} />)}
+        </linearGradient></defs>
+        <path
+          className={styles.body}
+          fill={`url(#${id})`}
+          d={avatarPaths[shape]}
+        />
+        <g className={styles.eyes} fill="white">
+          <rect
+            x="14"
+            y="14"
+            width="3.4"
+            height="8"
+            rx="1.7"
