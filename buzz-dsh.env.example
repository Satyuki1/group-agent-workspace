# 历史 ACP 配置草案：当前远端 Web 部署不使用本文件。参见 docs/OPERATIONS.md。
# 配置草案：未运行验证。用于 block/buzz 的 buzz-acp，不是新版 buzz-app 插件配置。
# 所有占位符必须替换；本文件不包含凭证，也不会创建 Agent 或群成员。
# 先安装并配置 DSH、buzz CLI、buzz-acp，在各 Agent 独立工作目录启动。

BUZZ_RELAY_URL=wss://YOUR_RELAY
BUZZ_PRIVATE_KEY=YOUR_AGENT_SECRET_KEY
BUZZ_ACP_AGENT_OWNER=OWNER_64_HEX_PUBKEY

BUZZ_ACP_AGENT_COMMAND=/ABSOLUTE/PATH/TO/dsh
BUZZ_ACP_AGENT_ARGS=--profile,acp

BUZZ_ACP_CHANNELS=GROUP_UUID
BUZZ_ACP_RESPOND_TO=allowlist
BUZZ_ACP_RESPOND_TO_ALLOWLIST=HUMAN_B_64_HEX_PUBKEY,COORDINATOR_64_HEX_PUBKEY,OTHER_AGENT_64_HEX_PUBKEY

# 专家 Agent 设置。三个群成员需三套独立身份，不能只把 AGENTS 改成 3。
BUZZ_ACP_SUBSCRIBE=mentions
BUZZ_ACP_SESSION_POLICY=thread
BUZZ_ACP_MULTIPLE_EVENT_HANDLING=queue
BUZZ_ACP_AGENTS=1
BUZZ_ACP_SYSTEM_PROMPT_FILE=/ABSOLUTE/PATH/TO/agent-role.md

# 群管家可改 SUBSCRIBE=all、SESSION_POLICY=channel；限定群与作者，加入静默/派工规则。
# 默认不处理自己的消息；不要开启 NO_IGNORE_SELF。
# 默认工具权限行为及 DM 限制见配套评估报告。
# DSH 模型凭证及 profile 单独按其官方文档配置，不假设一个 API_KEY 环境变量能完成全部设置。
