[Unit]
Description=Encrypted Group Agent backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /mnt/group-agent/releases/current/scripts/backup.py
ExecStopPost=/usr/bin/python3 /mnt/group-agent/releases/current/scripts/backup.py --recover
User=root
UMask=0077
CPUQuota=100%
MemoryMax=512M
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=10min
Restart=on-failure
RestartSec=15min

