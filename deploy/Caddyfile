  tls internal
  encode gzip
  header X-Content-Type-Options nosniff
  header Referrer-Policy same-origin
  reverse_proxy webhost:3001
}

https://{$GROUP_AGENT_HOST}:18444 {
  tls internal
  reverse_proxy relay:3000
}
