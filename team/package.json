{
  "name": "ds-bot-team",
  "productName": "DS Bot Team",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "start": "node server/main.ts",
    "runner": "node runner/main.ts",
    "admin": "node server/admin.ts",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "desktop": "electron .",
    "package": "electron-builder"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-store": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-code-language": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "^0.2.2-rc.1",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@shikijs/langs": "^4.4.3",
    "anser": "^2.3.5",
    "argon2": "^0.44.0",
    "clsx": "2.1.1",
    "deep-view": "0.1.2",
    "diff": "^9.0.0",
    "fastify": "^5.0.0",
    "immer": "^10.2.0",
    "katex": "^0.18.7",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "pg": "^8.16.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "simple-icons": "^16.31.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0",
    "zustand": "~4.5.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "app.dsbot.team",
    "files": [
      "*.cjs",
      "*.html",
      "*.css",
      "*.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "app": "desktop"
    },
    "mac": {
      "target": "zip"
    },
    "win": {
      "target": "nsis"
    }
  },
  "description": "Team messaging and Agent collaboration",
  "author": "DS Bot contributors"
}
